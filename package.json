{
  "name": "relay-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable, observable operating layer for AI agents.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx server/evaluate.ts",
    "check": "npm run build && npm test && npm run eval",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "deploy:pages": "node scripts/publish-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173",
    "eval:live": "tsx server/evals/run.ts --live",
    "eval:frontier": "tsx server/evals/run.ts --live --frontier"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "express": "^5.2.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
